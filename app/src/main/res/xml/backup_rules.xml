<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde automatique d'Android (Android 11 et moins). Toutes les bases sont exclues (cycle,
   messagerie, clés Signal) : leur clé vit dans le Keystore du téléphone et n'est jamais
   sauvegardée. Le changement de téléphone passe par EF-CPT-08.
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>