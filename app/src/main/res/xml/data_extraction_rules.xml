<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde et transfert d'Android 12 et plus. Toutes les bases sont exclues (cycle, messagerie,
   clés Signal) : elles sont chiffrées par une clé du Keystore qui n'est jamais copiée, et une
   copie restaurée ailleurs serait illisible. Le changement de téléphone passe par EF-CPT-08.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>