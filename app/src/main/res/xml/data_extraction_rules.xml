<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde et transfert d'Android 12 et plus. Les bases chiffrées sont exclues : leur clé vit
   dans le Keystore du téléphone et n'est jamais copiée (voir backup_rules.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="cocooning_cycle.db" />
        <exclude domain="database" path="cocooning_cycle.db-wal" />
        <exclude domain="database" path="cocooning_cycle.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="cocooning_cycle.db" />
        <exclude domain="database" path="cocooning_cycle.db-wal" />
        <exclude domain="database" path="cocooning_cycle.db-shm" />
    </device-transfer>
</data-extraction-rules>
